{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "convex-meetings",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "assets": { "binding": "ASSETS", "run_worker_first": ["/*.txt", "/*.md"] },
  "routes": [{ "pattern": "convex-meetings.stream", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
    "issues": {
      "enabled": true,
    },
  },
}
